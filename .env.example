# Required
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id
GUILD_ID=your_test_server_id

# Production persistence on Railway: use Railway PostgreSQL and paste its DATABASE_URL here.
# Local development can omit DATABASE_URL and use the JSON fallback.
DATABASE_URL=

# Optional
NODE_ENV=production
LOG_LEVEL=info

# Custom image emoji IDs. Upload the matching files from assets/emojis to your
# Discord server, then paste their IDs here. Blank IDs use the Unicode fallback.
NEXO_EMOJI_SPARK_ID=
NEXO_EMOJI_GLOW_ID=
NEXO_EMOJI_GUARDIAN_ID=
NEXO_EMOJI_ASTRAL_ID=
NEXO_EMOJI_PROFILE_ID=
NEXO_EMOJI_XP_ID=
NEXO_EMOJI_STREAK_ID=
NEXO_EMOJI_BADGE_ID=
NEXO_EMOJI_REWARD_ID=
NEXO_EMOJI_QUEST_ID=
NEXO_EMOJI_LOCKED_ID=
NEXO_EMOJI_PROGRESS_ID=
NEXO_EMOJI_COMPANION_ID=
NEXO_EMOJI_CHAT_ID=
NEXO_EMOJI_MILESTONE_ID=
NEXO_EMOJI_MEMORY_ID=
NEXO_EMOJI_WAIT_ID=
NEXO_EMOJI_SUN_ID=
NEXO_EMOJI_LEAF_ID=
NEXO_EMOJI_CHECK_ID=
