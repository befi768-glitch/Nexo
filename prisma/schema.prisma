generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id            String       @id @default(cuid())
  discordId     String       @unique
  name          String
  level         Int          @default(1)
  xp            Int          @default(0)
  hp            Int          @default(100)
  maxHp         Int          @default(100)
  attack        Int          @default(10)
  defense       Int          @default(5)
  coin          Int          @default(100)
  reputation    Int          @default(0)
  compassion    Int          @default(0)
  ruthlessness  Int          @default(0)
  curiosity     Int          @default(0)
  knowledge     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  cards         PlayerCard[]
  choices       ChoiceLog[]
}

model Card {
  id          String       @id
  name        String
  emoji       String
  description String
  rarity      String
  attack      Int
  defense     Int
  energy      Int
  skill       String
  playerCards PlayerCard[]
}

model PlayerCard {
  id        String   @id @default(cuid())
  playerId  String
  cardId    String
  level     Int      @default(1)
  bond      Int      @default(0)
  battles   Int      @default(0)
  memory    String   @default("")
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([playerId, cardId])
}

model ChoiceLog {
  id        String   @id @default(cuid())
  playerId  String
  eventId   String
  choiceId  String
  result    String
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@index([playerId, eventId])
}

model WorldState {
  id           String   @id @default(cuid())
  guildId      String   @unique
  forestDanger Int      @default(20)
  forestTrust  Int      @default(50)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}
