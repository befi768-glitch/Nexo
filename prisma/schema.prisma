generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id            String       @id @default(cuid())
  discordId     String       @unique
  name          String
  level         Int          @default(1)
  xp            Int           @default(0)
  hp            Int          @default(100)
  maxHp         Int          @default(100)
  attack        Int          @default(10)
  defense       Int          @default(5)
  coin          Int          @default(100)
  reputation    Int          @default(0)
  compassion    Int          @default(0)
  ruthlessness  Int          @default(0)
  curiosity     Int          @default(0)
  knowledge     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  gameplayLockedUntil DateTime?
  cards         PlayerCard[]
  choices       ChoiceLog[]
  adventureSessions AdventureSession[]
  memories     PlayerMemory[]
  factions     FactionStanding[]
  exploration  ExplorationState?
}

model Card {
  id          String       @id
  name        String
  emoji       String
  description String
  rarity      String
  attack      Int
  defense     Int
  energy      Int
  skill       String
  playerCards PlayerCard[]
}

model PlayerCard {
  id        String   @id @default(cuid())
  playerId  String
  cardId    String
  level     Int      @default(1)
  bond      Int      @default(0)
  battles   Int      @default(0)
  memory    String   @default("")
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  @@unique([playerId, cardId])
}

model ChoiceLog {
  id        String   @id @default(cuid())
  playerId  String
  eventId   String
  choiceId  String
  result    String
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@index([playerId, createdAt])
  @@index([playerId, eventId])
  @@unique([playerId, eventId])
}

model PlayerMemory {
  id        String   @id @default(cuid())
  playerId  String
  key       String
  value     String   @default("true")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([playerId, key])
  @@index([playerId, updatedAt])
}

model FactionStanding {
  id        String   @id @default(cuid())
  playerId  String
  factionId String
  value     Int      @default(0)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([playerId, factionId])
}

model WorldState {
  id           String   @id @default(cuid())
  guildId      String   @unique
  forestDanger Int      @default(20)
  forestTrust  Int      @default(50)
  activeEvent  String?
  eventEndsAt  DateTime?
  worldDay     Int      @default(1)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  events       WorldEvent[]
}

model WorldEvent {
  id          String   @id @default(cuid())
  guildId     String
  type        String
  title       String
  description String
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  world       WorldState @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  @@index([guildId, startedAt])
}

enum AdventureSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

model AdventureSession {
  id          String   @id @default(cuid())
  playerId    String
  guildId     String
  adventureId String
  status      AdventureSessionStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@index([playerId, status])
  @@index([expiresAt])
  @@unique([playerId, status])
}

model ExplorationState {
  id             String   @id @default(cuid())
  playerId       String   @unique
  charges        Int      @default(5)
  maxCharges     Int      @default(5)
  rechargeAt     DateTime?
  updatedAt      DateTime @updatedAt
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}
